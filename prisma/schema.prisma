generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Profile {
  id          String @id
  name        String
  description String
  links       ProfessionalLink[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model ProfessionalLink {
  id        String @id
  label     String
  url       String
  sortOrder Int
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, sortOrder])
}

model Skill {
  id        String @id
  name      String
  sortOrder Int
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, name])
  @@index([profileId, sortOrder])
}

model Experience {
  id           String @id
  company      String
  position     String
  period       String
  achievements String[]
  sortOrder    Int
  profileId    String
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, sortOrder])
}

model Project {
  id          String @id
  name        String
  description String
  link        String?
  sortOrder   Int
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, sortOrder])
}
